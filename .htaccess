# ===========================================================================
#  Einkaufszettel – Apache-Konfiguration
# ===========================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
<Files "index.html">
    ForceType text/html
</Files>

# --- Sensible Dateien sperren ----------------------------------------------
<IfModule mod_authz_core.c>
    # SQLite-Datenbanken, Journale, Backups, Logs, Doku
    <FilesMatch "(?i)\.(sqlite|sqlite3|db|db3|sqlite-journal|sqlite-wal|sqlite-shm|db-journal|bak|log|ini|md|sh|py)$">
        Require all denied
    </FilesMatch>
    # Konfiguration nie direkt ausliefern
    <Files "config.php">
        Require all denied
    </Files>
    # Versteckte Dateien (.git, .env, …) außer .well-known
    <FilesMatch "^\.(?!well-known)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(sqlite|sqlite3|db|db3|sqlite-journal|sqlite-wal|sqlite-shm|db-journal|bak|log|ini|md|sh|py)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "config.php">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Ordner "data" komplett sperren (zusätzlich zu data/.htaccess)
    RewriteRule ^data(/|$) - [F,L]

    # HTTPS erzwingen: Am besten in Plesk aktivieren ("Hosting-Einstellungen" ->
    # "Permanente SEO-sichere 301-Weiterleitung von HTTP zu HTTPS").
    # Alternativ hier einkommentieren:
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- MIME-Typen -------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/html                 .html
    AddType application/manifest+json .webmanifest
    AddType application/json          .json
    AddType image/svg+xml             .svg
    AddType text/javascript           .js
    AddCharset utf-8 .html .css .js .json .webmanifest
</IfModule>

# --- Header -----------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    # Service Worker, HTML und Manifest immer frisch prüfen, damit Updates ankommen
    <FilesMatch "^(sw\.js|index\.html|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Icons dürfen lange gecacht werden
    <FilesMatch "\.(png|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# PHP-Fehler nie im Browser anzeigen (greift nur bei mod_php; bei PHP-FPM in Plesk einstellen)
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
